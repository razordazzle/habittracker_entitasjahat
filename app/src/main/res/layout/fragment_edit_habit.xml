<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android">

    <data>
        <variable
            name="habit"
            type="com.example.habittracker_entitasjahat.model.Habit" />
    </data>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#F5F5F5">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <Button
                android:id="@+id/btnBack"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:backgroundTint="#6200EE"
                android:text="← Back"
                android:textColor="#FFFFFF" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="#FFFFFF"
                android:elevation="4dp"
                android:orientation="vertical"
                android:padding="24dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Edit Habit"
                    android:textColor="#222222"
                    android:textSize="24sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/txtHabitName"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginTop="24dp"
                    android:hint="Habit Name *"
                    android:text="@={habit.name}"
                    android:inputType="text"
                    android:padding="12dp" />

                <EditText
                    android:id="@+id/txtDescription"
                    android:layout_width="match_parent"
                    android:layout_height="110dp"
                    android:layout_marginTop="16dp"
                    android:gravity="top"
                    android:hint="Short Description *"
                    android:text="@={habit.description}"
                    android:inputType="textMultiLine"
                    android:padding="12dp" />

                <EditText
                    android:id="@+id/txtGoal"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginTop="16dp"
                    android:hint="Goal *"
                    android:text="@{String.valueOf(habit.goal)}"
                    android:inputType="number"
                    android:padding="12dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:text="How many to complete this task?"
                    android:textColor="#777777"
                    android:textSize="12sp" />

                <EditText
                    android:id="@+id/txtUnit"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginTop="16dp"
                    android:hint="Unit *"
                    android:text="@={habit.unit}"
                    android:inputType="text"
                    android:padding="12dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:text="e.g., glasses, minutes, pages, meals"
                    android:textColor="#777777"
                    android:textSize="12sp" />

                <Spinner
                    android:id="@+id/spinnerIcon"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginTop="16dp"
                    android:padding="12dp" />

            </LinearLayout>

            <Button
                android:id="@+id/btnUpdateHabit"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="24dp"
                android:backgroundTint="#2E7D32"
                android:text="Update Habit"
                android:textColor="#FFFFFF"
                android:textStyle="bold" />

        </LinearLayout>
    </ScrollView>
</layout>