<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main_navigation"
    app:startDestination="@id/loginFragment">

    <fragment
        android:id="@+id/loginFragment"
        android:name="com.example.habittracker_entitasjahat.view.LoginFragment"
        android:label="Login"
        tools:layout="@layout/fragment_login">

        <action
            android:id="@+id/action_loginFragment_to_dashboardFragment"
            app:destination="@id/dashboardFragment"
            app:popUpTo="@id/loginFragment"
            app:popUpToInclusive="true" />

    </fragment>

    <fragment
        android:id="@+id/dashboardFragment"
        android:name="com.example.habittracker_entitasjahat.view.DashboardFragment"
        android:label="Dashboard"
        tools:layout="@layout/fragment_dashboard">

        <action
            android:id="@+id/action_dashboardFragment_to_createHabitFragment"
            app:destination="@id/createHabitFragment" />
        <action
            android:id="@+id/action_dashboardFragment_to_editHabitFragment"
            app:destination="@id/editHabitFragment" />

    </fragment>

    <fragment
        android:id="@+id/createHabitFragment"
        android:name="com.example.habittracker_entitasjahat.view.CreateHabitFragment"
        android:label="Create Habit"
        tools:layout="@layout/fragment_create_habit" />

    <fragment
        android:id="@+id/editHabitFragment"
        android:name="com.example.habittracker_entitasjahat.view.EditHabitFragment"
        android:label="Edit Habit"
        tools:layout="@layout/fragment_edit_habit">

        <argument
            android:name="habitId"
            app:argType="integer" />
    </fragment>

</navigation>